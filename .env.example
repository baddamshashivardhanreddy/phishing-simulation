#--------------------------------------------------------------------
# ENVIRONMENT (Set to 'production' on live server, 'development' for local debug)
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP & BASE URL (Can be set here or managed dynamically via Nginx)
#--------------------------------------------------------------------
app.baseURL = 'http://admin.yourcompany.com/'

# Optional: You can also specify domains directly here or via Nginx fastcgi_param
# PHISH_SERVER_URL = 'http://rewards.yourcompany.com'
# ADMIN_SERVER_URL = 'http://admin.yourcompany.com'

#--------------------------------------------------------------------
# DATABASE CONFIGURATION
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = phishing_simulation
database.default.username = phish_user
database.default.password = YourStrongPasswordHere
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306

#--------------------------------------------------------------------
# LOGGING
#--------------------------------------------------------------------
logger.threshold = 4

